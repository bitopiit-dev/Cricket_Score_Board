# Copy to .env.local (ignored by git) and fill in. Only the project URL and the
# publishable / anon key belong here: never a service_role or secret key.
# Not used yet: Supabase arrives in step B. On GitHub, set the same two names
# as Actions variables (see README, "Supabase keys").
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Match alerts (optional): the PUBLIC VAPID key. Without it the Alerts page is hidden.
VITE_VAPID_PUBLIC_KEY=
